{
  "name": "orbyx",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "ORBYX - a cooperative 2D aerospace engineering adventure (Phaser 3 + TypeScript).",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "signal": "node signal-server.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "idb": "8.0.4",
    "peerjs": "1.5.5",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "express": "4.21.2",
    "peer": "1.0.2",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0",
    "ws": "8.18.3"
  }
}
